+func TestQueryNilLanguageNamedNodeType(t *testing.T) {
+	const src = "(identifier) @name"
+
+	q, err := NewQuery(src, nil)
+	if q != nil || err == nil {
+		t.Fatalf("NewQuery = %#v, %v; want nil query and non-nil error", q, err)
+	}
+
+	q2, err2 := NewQueryWithOptions(src, nil)
+	if q2 != nil || err2 == nil {
+		t.Fatalf("NewQueryWithOptions = %#v, %v; want nil query and non-nil error", q2, err2)
+	}
+
+	var unknown queryUnknownNodeTypeError
+	if !errors.As(err, &unknown) || !errors.As(err2, &unknown) {
+		t.Fatalf("errors = %v, %v; want queryUnknownNodeTypeError", err, err2)
+	}
