+func TestNewQueryRejectsNilLanguage(t *testing.T) {
+	tests := []struct {
+		name string
+		call func() (*Query, error)
+	}{
+		{
+			name: "NewQuery",
+			call: func() (*Query, error) { return NewQuery(`(identifier) @name`, nil) },
+		},
+		{
+			name: "NewQueryWithOptions",
+			call: func() (*Query, error) { return NewQueryWithOptions(`(identifier) @name`, nil) },
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			q, err := tt.call()
+			if err == nil {
+				t.Fatal("expected an error for a nil language")
+			}
+			if q != nil {
+				t.Fatalf("expected a nil query, got %#v", q)
+			}
+		})
