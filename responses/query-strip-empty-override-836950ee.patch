+func TestProbeStripEntireCaptureKeepsEmptyOverride(t *testing.T) {
+	source := []byte("hello")
+	parser := getParser(t)
+	tree, err := parse(parser, "pattern", source)
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	qc, err := newQueryCompiler().compile("(pattern) @cap (#strip! @cap ".*")")
+	if err != nil {
+		t.Fatalf("compile: %v", err)
+	}
+	matches := qc.exec(tree.RootNode(), source)
+	if len(matches) == 0 {
+		t.Fatal("expected at least one match")
+	}
+	for _, m := range matches {
+		for _, c := range m.captures {
+			if got := c.Text(source); got != "" {
+				t.Errorf("fully stripped capture text = %q, want empty", got)
+			}
+			if got, ok := qc.captureText("cap", m.captures, source); !ok || got != "" {
+				t.Errorf("generic predicate text lookup = %q, %v; want "", true", got, ok)
+			}
+		}
+	}
+}
+
+func TestQueryCaptureDirectTextOverrideStillWorks(t *testing.T) {
+	node := &Node{symbol: symbol(1), startByte: 0, endByte: uint32(len("hello"))}
+	source := []byte("hello")
+	c := QueryCapture{Name: "x", Node: node}
+	if got := c.Text(source); got != "hello" {
+		t.Fatalf("unchanged capture text = %q, want %q", got, "hello")
+	}
+	c.TextOverride = "override"
+	if got := c.Text(source); got != "override" {
+		t.Errorf("direct override text = %q, want %q", got, "override")
+	}
+}
