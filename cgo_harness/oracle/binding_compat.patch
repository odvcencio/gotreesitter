+
+// progressOptions preserves the harness timeout and cancellation API using
+// the upstream progress callback available in both oracle runtimes.
+func (p *Parser) progressOptions(options *ParseOptions) *ParseOptions {
+	var callback func(ParseState) bool
+	if options != nil {
+		callback = options.ProgressCallback
+	}
+	if p.timeoutMicros == 0 && p.cancellationFlag == nil {
+		if callback == nil {
+			return nil
+		}
+		return options
+	}
+	var deadline time.Time
+	if p.timeoutMicros != 0 {
+		micros := p.timeoutMicros
+		if micros > uint64((1<<63-1)/1000) {
+			micros = uint64((1<<63 - 1) / 1000)
+		}
+		deadline = time.Now().Add(time.Duration(micros) * time.Microsecond)
+	}
+	flag := p.cancellationFlag
+	return &ParseOptions{ProgressCallback: func(state ParseState) bool {
+		return (!deadline.IsZero() && !time.Now().Before(deadline)) ||
+			(flag != nil && atomic.LoadUintptr(flag) != 0) ||
+			(callback != nil && callback(state))
+	}}
+}
