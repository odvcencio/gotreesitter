+static inline void gts_work_count_add(uint64_t *slot, uint64_t delta) {
+  if (!slot || delta == 0) return;
+  if (UINT64_MAX - *slot < delta) {
+    *slot = UINT64_MAX;
+    gts_work_count_current.overflow = true;
+    return;
+  }
+  *slot += delta;
