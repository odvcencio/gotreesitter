+void gts_work_count_reset(void) {
+  gts_work_count_current = (GTSWorkCount) {0};
+  gts_topology_current = (GTSTopologyReceipt) {
+    .current_action_ordinal = -1,
+    .current_action_type = GTSTopologyActionUnknown,
+  };
