+		nodeCount := 0
+		candidates, reason := parser.cReductionCandidatesForAction(
+			nil,
+			start,
+			ParseAction{Type: ParseActionReduce, Symbol: 4, ChildCount: 2},
+			Token{},
+			&nodeCount,
+			arena,
+			&entryScratch,
