+
+// Consume the pinned grammar's html_character_reference after the initial '&'.
+// On failure every consumed character belongs to the surrounding JSX text.
+static bool scan_jsx_character_reference(TSLexer *lexer) {
+    advance(lexer);
+    bool numeric = lexer->lookahead == '#';
+    bool hex = false;
+    if (numeric) {
+        advance(lexer);
+        hex = lexer->lookahead == 'x' || lexer->lookahead == 'X';
+        if (hex) advance(lexer);
+    }
+    unsigned limit = hex ? 6 : numeric ? 5 : 30;
+    unsigned count = 0;
+    while (count < limit) {
+        int32_t c = lexer->lookahead;
+        bool digit = '0' <= c && c <= '9';
+        bool letter = ('a' <= c && c <= 'z') || ('A' <= c && c <= 'Z');
+        bool hex_letter = ('a' <= c && c <= 'f') || ('A' <= c && c <= 'F');
+        if (!(numeric ? digit || (hex && hex_letter) : letter)) break;
+        advance(lexer);
+        count++;
+    }
+    if (count == 0 || lexer->lookahead != ';') return false;
+    advance(lexer);
+    return true;
+}
