+package parsercorephase0
+
+// ElectionRecord is the complete externally observed election. The token is
+// supplied by the scheduler at projection, rather than stored twice per turn.
+type ElectionRecord[S, C, T any] struct {
+	States                 []S
+	Token                  T
+	ScannerBefore          C
+	ScannerAfter           C
+	CurrentCheckpointValid bool
+	CurrentCheckpointStart C
+	CurrentCheckpointEnd   C
+	CurrentCheckpointBytes [2]uint32
+}
+
+// ElectionCheckpointPair holds the cold full-receipt checkpoint digests of a
+// shared election. Owned elections derive these from their before/after pair.
+type ElectionCheckpointPair[C any] struct{ Start, End C }
+
+type electionKind uint8
+
+const (
+	electionSharedSummary electionKind = iota
+	electionSharedFull
+	electionOwned
+)
+
+// ElectionState retains the exact fields scheduling and EOF validation read.
+// States has the same borrowed/owned lifetime as the original election record.
+// A scheduler updates its authoritative token alongside this state.
+type ElectionState[S, C any] struct {
+	States                 []S
+	ScannerBefore          C
+	ScannerAfter           C
+	CurrentCheckpointBytes [2]uint32
+	CurrentCheckpointValid bool
+	kind                   electionKind
+}
+
+func SharedElectionState[S, C any](states []S, before, after C, valid bool, currentBytes [2]uint32, full bool) ElectionState[S, C] {
+	kind := electionSharedSummary
+	if full {
+		kind = electionSharedFull
+	}
+	return ElectionState[S, C]{States: states, ScannerBefore: before, ScannerAfter: after, CurrentCheckpointValid: valid, CurrentCheckpointBytes: currentBytes, kind: kind}
+}
+
+func OwnedElectionState[S, C any](before, after C, currentBytes [2]uint32) ElectionState[S, C] {
+	return ElectionState[S, C]{ScannerBefore: before, ScannerAfter: after, CurrentCheckpointValid: true, CurrentCheckpointBytes: currentBytes, kind: electionOwned}
+}
+
+// HasSharedCheckpointDetails reports whether restoration needs the cold pair.
+// An owned record projects its own before/after values instead of that pair.
+func (s *ElectionState[S, C]) HasSharedCheckpointDetails() bool { return s.kind == electionSharedFull }
+
+// ProjectElection returns the same complete record used by diagnostic readers.
+// It borrows only the state slice. All token and checkpoint fields are copied.
+func ProjectElection[S, C, T any](s *ElectionState[S, C], token T, cold *ElectionCheckpointPair[C]) ElectionRecord[S, C, T] {
+	out := ElectionRecord[S, C, T]{States: s.States, Token: token, ScannerBefore: s.ScannerBefore, ScannerAfter: s.ScannerAfter, CurrentCheckpointValid: s.CurrentCheckpointValid, CurrentCheckpointBytes: s.CurrentCheckpointBytes}
+	switch s.kind {
+	case electionSharedFull:
+		out.CurrentCheckpointStart = cold.Start
+		out.CurrentCheckpointEnd = cold.End
+	case electionOwned:
+		out.CurrentCheckpointStart = s.ScannerBefore
+		out.CurrentCheckpointEnd = s.ScannerAfter
+	}
+	return out
+}
