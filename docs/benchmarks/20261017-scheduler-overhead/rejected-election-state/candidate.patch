+package parsercorephase0
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestElectionStateProjectionModes(t *testing.T) {
+	states := []uint32{2, 4}
+	cold := ElectionCheckpointPair[uint64]{Start: 17, End: 19}
+	full := SharedElectionState(states, uint64(3), uint64(5), true, [2]uint32{11, 13}, true)
+	want := ElectionRecord[uint32, uint64, uint64]{States: states, Token: 23, ScannerBefore: 3, ScannerAfter: 5, CurrentCheckpointValid: true, CurrentCheckpointStart: 17, CurrentCheckpointEnd: 19, CurrentCheckpointBytes: [2]uint32{11, 13}}
+	if got := ProjectElection(&full, uint64(23), &cold); !reflect.DeepEqual(got, want) {
+		t.Fatalf("full=%+v want=%+v", got, want)
+	}
+	summary := SharedElectionState(states, uint64(3), uint64(5), true, [2]uint32{11, 13}, false)
+	want.CurrentCheckpointStart = 0
+	want.CurrentCheckpointEnd = 0
+	if got := ProjectElection(&summary, uint64(23), &cold); !reflect.DeepEqual(got, want) {
+		t.Fatalf("summary=%+v want=%+v", got, want)
+	}
+	owned := OwnedElectionState[uint32](uint64(3), uint64(5), [2]uint32{11, 13})
+	want.States = nil
+	want.CurrentCheckpointStart = 3
+	want.CurrentCheckpointEnd = 5
+	if got := ProjectElection(&owned, uint64(23), &cold); !reflect.DeepEqual(got, want) {
+		t.Fatalf("owned=%+v want=%+v", got, want)
+	}
+	if !full.HasSharedCheckpointDetails() || summary.HasSharedCheckpointDetails() || owned.HasSharedCheckpointDetails() {
+		t.Fatal("cold snapshot classification changed")
+	}
+}
