+func testElectionState(e DiagnosticParserCoreElection) core.ElectionState[StateID, DiagnosticParserCoreScannerCheckpoint] {
+	return core.SharedElectionState(e.States, e.ScannerBefore, e.ScannerAfter, e.CurrentCheckpointValid, e.CurrentCheckpointBytes, true)
+}
+func testSetElection(s *diagnosticParserCoreGenericScheduler, e DiagnosticParserCoreElection) {
+	s.token = e.Token
+	s.currentElection = testElectionState(e)
+	s.electionCheckpoints = core.ElectionCheckpointPair[DiagnosticParserCoreScannerCheckpoint]{Start: e.CurrentCheckpointStart, End: e.CurrentCheckpointEnd}
+}
+
+func TestElectionStateSplitProjectionAndLayout(t *testing.T) {
+	before := DiagnosticParserCoreScannerCheckpoint{Length: 3, SHA256: [32]byte{1}}
+	after := DiagnosticParserCoreScannerCheckpoint{Length: 5, SHA256: [32]byte{2}}
+	start := DiagnosticParserCoreScannerCheckpoint{Length: 7, SHA256: [32]byte{3}}
+	end := DiagnosticParserCoreScannerCheckpoint{Length: 9, SHA256: [32]byte{4}}
+	token := Token{Symbol: 7, StartByte: 11, EndByte: 13}
+	states := []StateID{2, 4}
+	full := DiagnosticParserCoreElection{States: states, Token: token, ScannerBefore: before, ScannerAfter: after, CurrentCheckpointValid: true, CurrentCheckpointStart: start, CurrentCheckpointEnd: end, CurrentCheckpointBytes: [2]uint32{17, 19}}
+	scheduler := diagnosticParserCoreGenericScheduler{}
+	testSetElection(&scheduler, full)
+	if got := scheduler.currentElectionReceipt(); !reflect.DeepEqual(got, full) {
+		t.Fatalf("full record changed: got=%+v want=%+v", got, full)
+	}
+	scheduler.currentElection = core.SharedElectionState(states, before, after, true, [2]uint32{17, 19}, false)
+	summary := full
+	summary.CurrentCheckpointStart = DiagnosticParserCoreScannerCheckpoint{}
+	summary.CurrentCheckpointEnd = DiagnosticParserCoreScannerCheckpoint{}
+	if got := scheduler.currentElectionReceipt(); !reflect.DeepEqual(got, summary) {
+		t.Fatalf("summary used stale cold fields: got=%+v want=%+v", got, summary)
+	}
+	scheduler.currentElection = core.OwnedElectionState[StateID](before, after, [2]uint32{11, 13})
+	owned := DiagnosticParserCoreElection{Token: token, ScannerBefore: before, ScannerAfter: after, CurrentCheckpointValid: true, CurrentCheckpointStart: before, CurrentCheckpointEnd: after, CurrentCheckpointBytes: [2]uint32{11, 13}}
+	if got := scheduler.currentElectionReceipt(); !reflect.DeepEqual(got, owned) {
+		t.Fatalf("owned record changed: got=%+v want=%+v", got, owned)
+	}
+	if got := testing.AllocsPerRun(100, func() { _ = scheduler.currentElectionReceipt() }); got != 0 {
+		t.Fatalf("projection allocs=%v", got)
+	}
+	stateBytes := unsafe.Sizeof(scheduler.currentElection)
+	coldBytes := unsafe.Sizeof(scheduler.electionCheckpoints)
+	recordBytes := unsafe.Sizeof(full)
+	if stateBytes+coldBytes >= recordBytes {
+		t.Fatalf("split does not reduce retained bytes: state=%d cold=%d full=%d", stateBytes, coldBytes, recordBytes)
+	}
+	t.Logf("election state=%d cold=%d old record=%d", stateBytes, coldBytes, recordBytes)
+}
