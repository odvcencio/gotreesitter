+func TestCompactDeferredPublicationReadTransfer(t *testing.T) {
+	arena := acquireNodeArena(arenaClassFull)
+	defer arena.Release()
+	m := compactMaterializer{arena: arena}
+	m.nodesByID.Prepare(4)
+	arena.compactLeafPublication = &m
+	leaf := newCompactFullLeafInArena(arena, 1, true, 0, 4, Point{}, Point{Column: 4})
+	leaf.publication = true
+	leaf.checkpoint.end.off = 1
+	leaf.setFlag(nodeFlagCompactMaterialized, true)
+	leaf.setFlag(nodeFlagCompactParseStateProven, true)
+	leaf.parseState = 7
+	m.nodesByID.SetLeaf(1, leaf)
+	reads := incr.NewReads(8)
+	reads.Record(0, 5)
+	reads.Record(4, 9)
+	s := diagnosticParserCoreGenericScheduler{}
+	s.reuseDependencies.reads = reads
+	s.reuseDependencies.leafWords = make([]uint32, 1)
+	incr.SetLeafReceipt(s.reuseDependencies.leafWords, 1, legacyReuseLeafKnown|legacyReuseKeyword)
+	points := diagnosticParserCorePointIndex{lineStarts: []uint32{0}}
+	if err := s.publishCompactLegacyReads(arena, &m.nodesByID, func(core.SubtreeID) (core.SubtreeGeometry, error) { return core.SubtreeGeometry{EndByte: 4}, nil }, &points, func() error { return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if !leaf.hasLegacyRead {
+		t.Fatal("deferred leaf lacks a read receipt")
+	}
+	rng, refs := arena.allocPendingChildEntries(1)
+	refs[0] = newPendingChildEntry(newStackEntryCompactFullLeaf(0, leaf))
+	parent := newParentNodeInArenaWithFinalChildRefs(arena, 2, true, rng, 0, true)
+	child := parent.Child(0)
+	if m.nodesByID.Node(1) != child || child != parent.Child(0) || child.Parent() != parent {
+		t.Fatal("public view identity or publication mapping changed")
+	}
+	want, known := reads.LeafLookahead(4)
+	if got, ok := legacyReuseLookahead(child); got != want || ok != known {
+		t.Fatalf("lookahead=%d/%t want=%d/%t", got, ok, want, known)
+	}
+	if word := legacyReuseWord(child, false); word == nil || *word&(legacyReuseKeyword|legacyReuseLeafKnown) != legacyReuseKeyword|legacyReuseLeafKnown {
+		t.Fatal("elected token provenance lost")
+	}
+	if child.parseState != 7 || !compactNodeStateProofAvailable(child) {
+		t.Fatal("replay proof lost")
+	}
+	m.releaseOwned()
+	if arena.compactLeafPublication != nil {
+		t.Fatal("escaped arena retains materializer")
+	}
+}
