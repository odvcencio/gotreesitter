+func TestCompactDeferredPublicationDirectFieldsAndExtras(t *testing.T) {
+	arena := acquireNodeArena(arenaClassFull)
+	defer arena.Release()
+	lang := &Language{SymbolMetadata: make([]SymbolMetadata, 4), FieldNames: []string{"", "left", "right"}, FieldMapSlices: [][2]uint16{{0, 2}}, FieldMapEntries: []FieldMapEntry{{FieldID: 1, ChildIndex: 0}, {FieldID: 2, ChildIndex: 1}}}
+	for i := range lang.SymbolMetadata {
+		lang.SymbolMetadata[i] = SymbolMetadata{Visible: true, Named: true}
+	}
+	m := compactMaterializer{arena: arena, parser: NewParser(lang), points: diagnosticParserCorePointIndex{lineStarts: []uint32{0}}}
+	left := newCompactFullLeafInArena(arena, 1, true, 0, 1, Point{}, Point{Column: 1})
+	extra := newLeafNodeInArena(arena, 2, true, 1, 2, Point{Column: 1}, Point{Column: 2})
+	extra.setExtra(true)
+	right := newCompactFullLeafInArena(arena, 1, true, 2, 3, Point{Column: 2}, Point{Column: 3})
+	left.dynamicPrecedence = 2
+	right.dynamicPrecedence = 3
+	entries := []stackEntry{newStackEntryCompactFullLeaf(0, left), newStackEntryNode(0, extra), newStackEntryCompactFullLeaf(0, right)}
+	parent := m.makeDirectPublicationParent(&core.MaterializationSubtreeView{Symbol: 3, EndByte: 3, DynamicPrecedence: 4}, entries, 2, true)
+	if parent == nil || !nodeHasFinalChildRefs(parent) {
+		t.Fatal("direct projection forced public leaves")
+	}
+	if parent.ChildCount() != 3 || parent.NamedChildCount() != 3 || parent.FieldNameForChild(0, lang) != "left" || parent.FieldNameForChild(1, lang) != "" || parent.FieldNameForChild(2, lang) != "right" {
+		t.Fatal("field ordinals consumed an extra or child count changed")
+	}
+	if parent.dynamicPrecedence != 9 || parent.EndPoint() != (Point{Column: 3}) || extra.Parent() != parent {
+		t.Fatal("parent metadata or existing child link lost")
+	}
+	if left.publication || right.publication {
+		t.Fatal("fixture leaf unexpectedly marked as a compact publication")
+	}
+	if parent.ChildByFieldName("right", lang) != parent.Child(2) {
+		t.Fatal("field and index access disagree")
+	}
+}
