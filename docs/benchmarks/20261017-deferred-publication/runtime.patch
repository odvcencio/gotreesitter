+func TestCompactDeferredPublicationNonLeafReuse(t *testing.T) {
+	p, session, node, _, _, points := compactBorrowedMaterializationFixture(t)
+	arena := node.ownerArena
+	top := session.oldTree.root
+	// Both candidate levels must work when the root and its child retain typed
+	// references. Reading only Node.children would silently lose these receipts.
+	topRange, topRefs := arena.allocPendingChildEntries(len(top.children))
+	for i, child := range top.children {
+		topRefs[i] = newPendingChildEntry(newStackEntryNode(0, child))
+	}
+	top.children = nil
+	arena.attachFinalChildRefs(top, topRange)
+	rootRange, rootRefs := arena.allocPendingChildEntries(1)
+	rootRefs[0] = newPendingChildEntry(newStackEntryNode(0, top))
+	root := newParentNodeInArenaWithFinalChildRefs(arena, 4, true, rootRange, 0, true)
+	s := diagnosticParserCoreGenericScheduler{}
+	s.reuseDependencies.ends = []uint32{0, 4, 6}
+	refs := publicationRefsForNodes([]*Node{nil, node, node})
+	if err := s.publishCompactReuseDependencies(p, root, arena, refs, compactReusePublicationFixtureView, &points, 0, func() error { return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if bytes, ok := compactReuseDependencyForNode(node); !ok || bytes != 5 {
+		t.Fatalf("nested final reference lost dependency: %d/%t", bytes, ok)
+	}
+	if root.children != nil || top.children != nil {
+		t.Fatal("dependency publication forced child arrays")
+	}
+	s.reuseDependencies.disabled = true
+	if err := s.publishCompactReuseDependencies(p, root, arena, refs, compactReusePublicationFixtureView, &points, 0, func() error { return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := compactReuseDependencyForNode(node); ok {
+		t.Fatal("disabled producer retained a deferred candidate's receipt")
+	}
+}
