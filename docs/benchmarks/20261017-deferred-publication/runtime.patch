+package parsercorephase0
+
+import "unsafe"
+
+// PublicationRefs retains one pointer per compact ID and a lazily allocated
+// kind bitmap. It keeps node and deferred-leaf references distinct without
+// retaining two pointer arrays. IDs are occurrence identities; zero is empty.
+// The pointer slice keeps both allocation types visible to the Go collector.
+type PublicationRefs[N, L any] struct {
+	refs      []unsafe.Pointer
+	leafKinds []uint64
+	leafCount int
+}
+
+func (r *PublicationRefs[N, L]) Len() int {
+	if r == nil {
+		return 0
+	}
+	return len(r.refs)
+}
+func (r *PublicationRefs[N, L]) Cap() int {
+	if r == nil {
+		return 0
+	}
+	return cap(r.refs)
+}
+
+func (r *PublicationRefs[N, L]) Has(id SubtreeID) bool {
+	return r != nil && id != 0 && uint64(id) < uint64(len(r.refs)) && r.refs[id] != nil
+}
+
+func (r *PublicationRefs[N, L]) Node(id SubtreeID) *N {
+	if !r.Has(id) || r.isLeaf(id) {
+		return nil
+	}
+	return (*N)(r.refs[id])
+}
+
+func (r *PublicationRefs[N, L]) Leaf(id SubtreeID) *L {
+	if !r.Has(id) || !r.isLeaf(id) {
+		return nil
+	}
+	return (*L)(r.refs[id])
+}
+
+func (r *PublicationRefs[N, L]) isLeaf(id SubtreeID) bool {
+	word := uint64(id) >> 6
+	return word < uint64(len(r.leafKinds)) && r.leafKinds[word]&(uint64(1)<<(id&63)) != 0
+}
+
+func (r *PublicationRefs[N, L]) SetNode(id SubtreeID, node *N) bool {
+	if id == 0 || uint64(id) >= uint64(len(r.refs)) {
+		return false
+	}
+	if r.isLeaf(id) {
+		r.leafKinds[uint64(id)>>6] &^= uint64(1) << (id & 63)
+		r.leafCount--
+	}
+	r.refs[id] = unsafe.Pointer(node)
+	return true
+}
+
+func (r *PublicationRefs[N, L]) SetLeaf(id SubtreeID, leaf *L) bool {
+	if id == 0 || uint64(id) >= uint64(len(r.refs)) {
+		return false
+	}
+	if leaf == nil {
+		return r.SetNode(id, nil)
+	}
+	words := (len(r.refs) + 63) / 64
+	if len(r.leafKinds) < words {
+		if cap(r.leafKinds) < words {
+			grown := make([]uint64, words)
+			copy(grown, r.leafKinds)
+			r.leafKinds = grown
+		} else {
+			old := len(r.leafKinds)
+			r.leafKinds = r.leafKinds[:words]
+			clear(r.leafKinds[old:])
+		}
+	}
+	if !r.isLeaf(id) {
+		r.leafKinds[uint64(id)>>6] |= uint64(1) << (id & 63)
+		r.leafCount++
+	}
+	r.refs[id] = unsafe.Pointer(leaf)
+	return true
+}
+
+func (r *PublicationRefs[N, L]) Prepare(n int) {
+	r.Reset(0)
+	if n <= 0 {
+		return
+	}
+	if cap(r.refs) < n {
+		r.refs = make([]unsafe.Pointer, n)
+	} else {
+		r.refs = r.refs[:n]
+	}
+}
+
+func (r *PublicationRefs[N, L]) Ensure(n int) {
+	if n <= len(r.refs) {
+		return
+	}
+	if cap(r.refs) < n {
+		grown := make([]unsafe.Pointer, n, max(n, 2*cap(r.refs), 1024))
+		copy(grown, r.refs)
+		r.refs = grown
+	} else {
+		old := len(r.refs)
+		r.refs = r.refs[:n]
+		clear(r.refs[old:])
+	}
+	// Bits beyond the current bitmap are implicitly node references. Allocate
+	// them only when SetLeaf first needs that part of the ID range.
+}
+
+// Reset clears the full retained pointer capacity, including borrowed views.
+// A positive limit drops storage above that reference count.
+func (r *PublicationRefs[N, L]) Reset(limit int) {
+	clear(r.refs[:cap(r.refs)])
+	clear(r.leafKinds[:cap(r.leafKinds)])
+	if limit > 0 && cap(r.refs) > limit {
+		*r = PublicationRefs[N, L]{}
+		return
+	}
+	r.refs = r.refs[:0]
+	r.leafKinds = r.leafKinds[:0]
+	r.leafCount = 0
+}
+
+func (r *PublicationRefs[N, L]) RetainedBytes() uint64 {
+	return uint64(cap(r.refs))*uint64(unsafe.Sizeof(unsafe.Pointer(nil))) + r.KindRetainedBytes()
+}
+
+func (r *PublicationRefs[N, L]) KindRetainedBytes() uint64 {
+	return uint64(cap(r.leafKinds)) * 8
+}
+
+// RetainedEmpty checks capacity, not just length, so lifetime checks detect
+// references left in a reused table's otherwise inaccessible tail.
+func (r *PublicationRefs[N, L]) RetainedEmpty() bool {
+	if r == nil {
+		return true
+	}
+	for _, ref := range r.refs[:cap(r.refs)] {
+		if ref != nil {
+			return false
+		}
+	}
+	for _, kinds := range r.leafKinds[:cap(r.leafKinds)] {
+		if kinds != 0 {
+			return false
+		}
+	}
+	return true
+}
