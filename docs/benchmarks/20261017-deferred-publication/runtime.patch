+func TestPublicationRefsKeepKindsAcrossGrowthAndCollection(t *testing.T) {
+	type node struct{ text *string }
+	type leaf struct{ bytes []byte }
+	var refs PublicationRefs[node, leaf]
+	refs.Prepare(130)
+	text := "node"
+	n := &node{text: &text}
+	l := &leaf{bytes: []byte("leaf")}
+	if !refs.SetNode(64, n) || !refs.SetLeaf(65, l) {
+		t.Fatal("valid references rejected")
+	}
+	refs.Ensure(300)
+	n, l = nil, nil
+	runtime.GC()
+	if got := refs.Node(64); got == nil || *got.text != "node" || refs.Leaf(64) != nil {
+		t.Fatal("node identity/kind lost after growth and collection")
+	}
+	if got := refs.Leaf(65); got == nil || string(got.bytes) != "leaf" || refs.Node(65) != nil {
+		t.Fatal("leaf identity/kind lost after growth and collection")
+	}
+	if refs.SetNode(0, &node{}) || refs.SetLeaf(300, &leaf{}) || refs.Has(0) || refs.Has(300) {
+		t.Fatal("invalid identity accepted")
+	}
+	replacement := &node{text: &text}
+	refs.SetNode(65, replacement)
+	if refs.Node(65) != replacement || refs.Leaf(65) != nil {
+		t.Fatal("replacement retained the previous kind")
+	}
+
+}
+
+func TestPublicationRefsResetClearsBorrowedCapacityAndRetention(t *testing.T) {
+	var refs PublicationRefs[int, string]
+	refs.Prepare(130)
+	n := 7
+	view := refs.refs[:cap(refs.refs)]
+	view[len(view)-1] = unsafe.Pointer(&n)
+	retained := refs.RetainedBytes()
+	if refs.RetainedEmpty() {
+		t.Fatal("tail reference was not observed")
+	}
+	refs.Reset(0)
+	if view[len(view)-1] != nil || !refs.RetainedEmpty() || refs.Len() != 0 || refs.RetainedBytes() != retained {
+		t.Fatal("reset lost retention or kept a tail pointer")
+	}
+	view = nil
+	refs.Prepare(130)
+	s := "leaf"
+	refs.SetLeaf(65, &s)
+	retained = refs.RetainedBytes()
+	refs.Reset(0)
+	if refs.RetainedBytes() != retained {
+		t.Fatal("reset dropped kind storage")
+	}
+	refs.Prepare(130)
+	if refs.Has(65) || refs.Leaf(65) != nil {
+		t.Fatal("reset retained a leaf or kind")
+	}
+	refs.Reset(1)
+	if refs.Cap() != 0 || refs.RetainedBytes() != 0 {
+		t.Fatal("retention limit kept storage")
+	}
+}
+
+func TestPublicationRefsColdPrepareKeepsRequestedFootprint(t *testing.T) {
+	var refs PublicationRefs[int, string]
+	refs.Prepare(17)
+	if refs.Len() != 17 || refs.Cap() != 17 || refs.KindRetainedBytes() != 0 {
+		t.Fatalf("cold references = %d/%d, kind bytes=%d", refs.Len(), refs.Cap(), refs.KindRetainedBytes())
+	}
+	refs.Ensure(33)
+	if refs.Cap() < 33 {
+		t.Fatal("eager growth did not preserve capacity")
+	}
+	n := 9
+	refs.SetNode(32, &n)
+	refs.Prepare(17)
+	if refs.Len() != 17 || refs.Node(16) != nil {
+		t.Fatal("repreparation retained a prior node")
+	}
+}
