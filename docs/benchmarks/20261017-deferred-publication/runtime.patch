+func TestCompactDeferredPublicationProofDoesNotConstructViews(t *testing.T) {
+	proven := nodeFlagCompactMaterialized | nodeFlagCompactParseStateProven
+	for _, row := range []struct {
+		name               string
+		flags, parentFlags nodeFlags
+		want               bool
+	}{
+		{"proven", proven, 0, true},
+		{"unknown", 0, 0, false},
+		{"not_materialized", nodeFlagCompactParseStateProven, 0, false},
+		{"no_state_proof", nodeFlagCompactMaterialized, 0, false},
+		{"extra", nodeFlagExtra, 0, true},
+		{"missing", nodeFlagMissing, 0, true},
+		{"error", nodeFlagHasError, 0, true},
+		{"fragile", nodeFlagFragileLeft, 0, true},
+		{"sibling_error_does_not_exempt", 0, nodeFlagHasError, false},
+		{"recovery_ancestor", 0, nodeFlagMissing, true},
+	} {
+		t.Run(row.name, func(t *testing.T) {
+			arena := acquireNodeArena(arenaClassFull)
+			defer arena.Release()
+			leaf := newCompactFullLeafInArena(arena, 1, true, 0, 1, Point{}, Point{Column: 1})
+			leaf.publication = true
+			leaf.flags = row.flags
+			rng, refs := arena.allocPendingChildEntries(1)
+			refs[0] = newPendingChildEntry(newStackEntryCompactFullLeaf(0, leaf))
+			root := newParentNodeInArenaWithFinalChildRefs(arena, 2, true, rng, 0, true)
+			root.flags = row.parentFlags
+			before := arena.used
+			scratch := make([]*Node, 0, 4)
+			if got := compactTreeIncrementalReuseProven(root, &scratch); got != row.want {
+				t.Fatalf("proof=%t want=%t", got, row.want)
+			}
+			if arena.used != before || stackEntryCompactFullLeaf(rng.refs(arena)[0].stackEntry()) != leaf {
+				t.Fatal("proof check constructed a public view")
+			}
+			if len(scratch) != 0 {
+				t.Fatal("proof check retained traversal nodes")
+			}
+		})
+	}
+}
