+package parsercorephase0
+
+// MaterializationParentUse describes the authenticated incoming occurrence.
+// It is supplied only by the parent-aware walk, after the ownership checks.
+// Root payloads have no parent. Sibling counts include extras.
+type MaterializationParentUse struct {
+	Symbol       Symbol
+	ProductionID uint16
+	ChildCount   uint32
+	Present      bool
+	Last         bool
+}
+
+// HiddenTailTerminalCanBeOmitted checks the compact half of an elision proof.
+// The adapter must also prove that the terminal is hidden, the parent has no
+// aliases or fields, and fresh publication needs no scanner checkpoint.
+func HiddenTailTerminalCanBeOmitted(view *MaterializationSubtreeView) bool {
+	return view != nil && view.Terminal && !view.Missing && !view.Extra && !view.Fragile &&
+		view.ReusedKey == 0 && view.Symbol != RecoveryErrorSymbol && !view.LexerSkippedPrefix &&
+		view.ParentUse.Present && view.ParentUse.Last && view.ParentUse.ChildCount > 1 && view.ParentUse.Symbol != RecoveryErrorSymbol
+}
+
+// VisitMaterializationPostorderWithParentUse preserves replay, validation,
+// exclusive occurrence ownership, stop polling and rollback of the existing
+// borrowed walk. The additional context can select an object's representation
+// before a visitor constructs it; it never bypasses a compact record visit.
+func (c *Core) VisitMaterializationPostorderWithParentUse(roots []SubtreeID, poll func() error, scratch *MaterializationPostorderScratch, rootPre StateID, transition MaterializationReplayBorrowedTransition, prebuilt func(SubtreeID) bool, visit func(SubtreeID, *MaterializationSubtreeView) error) error {
+	return c.visitMaterializationPostorderBorrowed(roots, poll, scratch, rootPre, transition, prebuilt, visit, true)
+}
