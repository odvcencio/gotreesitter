+package gotreesitter
+
+import (
+	core "github.com/odvcencio/gotreesitter/internal/parsercorephase0"
+	"testing"
+)
+
+func TestCompactHiddenTailTerminalConstruction(t *testing.T) {
+	for _, name := range []string{"elide", "visible", "root", "middle", "unary", "fielded", "aliased", "comparison", "incremental", "eager", "recovery"} {
+		t.Run(name, func(t *testing.T) {
+			lang := &Language{SymbolNames: []string{"end", "visible", "hidden", "parent"}, SymbolMetadata: []SymbolMetadata{{}, {Visible: true, Named: true}, {}, {Visible: true, Named: true}}}
+			if name == "fielded" {
+				lang.FieldMapSlices = [][2]uint16{{0, 1}}
+				lang.FieldMapEntries = []FieldMapEntry{{FieldID: 1, ChildIndex: 0}}
+			}
+			if name == "aliased" {
+				lang.AliasSequences = [][]Symbol{{1, 0}}
+			}
+			arena := acquireNodeArena(arenaClassFull)
+			defer arena.Release()
+			m := compactMaterializer{parser: NewParser(lang), source: []byte("ab"), arena: arena, points: diagnosticParserCorePointIndex{lineStarts: []uint32{0}}, purpose: core.MaterializationForPublication}
+			m.prepareTables(2)
+			v := core.MaterializationSubtreeView{Symbol: 2, Terminal: true, StartByte: 1, EndByte: 2, ParentUse: core.MaterializationParentUse{Present: true, Last: true, ChildCount: 2, Symbol: 3}}
+			switch name {
+			case "visible":
+				v.Symbol = 1
+			case "root":
+				v.ParentUse.Present = false
+			case "middle":
+				v.ParentUse.Last = false
+			case "unary":
+				v.ParentUse.ChildCount = 1
+			case "comparison":
+				m.purpose = core.MaterializationForComparison
+			case "incremental":
+				m.incrementalReuse = &compactIncrementalReuseSession{}
+			case "eager":
+				m.eager = true
+			case "recovery":
+				m.allowErrorRoot = true
+			}
+			before := arena.used
+			if err := m.visit(1, &v); err != nil {
+				t.Fatal(err)
+			}
+			if name == "elide" {
+				if arena.used != before || m.nodesByID[1] != &compactElidedTailTerminal {
+					t.Fatal("discarded terminal constructed a public node")
+				}
+			} else if arena.used != before+1 || m.nodesByID[1] == &compactElidedTailTerminal {
+				t.Fatal("required terminal was elided")
+			}
+			m.clearState()
+			for _, node := range m.nodesByID[:cap(m.nodesByID)] {
+				if node != nil {
+					t.Fatal("elision marker retained in idle scratch")
+				}
+			}
+		})
+	}
+}
+
+func TestCompactHiddenTailCoverageUsesRawSpan(t *testing.T) {
+	leaf := noTreeNode{startByte: 0, endByte: 1}
+	entries := []stackEntry{newStackEntryNoTreeNode(0, &leaf)}
+	if start, end, gap := diagnosticParserCoreReduceChildrenTilingGap(0, 3, entries, []byte("a b")); !gap || start != 1 || end != 3 {
+		t.Fatalf("uncovered suffix escaped: %d..%d %t", start, end, gap)
+	}
+	leaf.startByte, leaf.endByte = 1, 3
+	if start, end, gap := diagnosticParserCoreReduceChildrenTilingGap(0, 3, entries, []byte("xab")); !gap || start != 0 || end != 1 {
+		t.Fatalf("uncovered prefix escaped: %d..%d %t", start, end, gap)
+	}
+}
