+func TestMaterializationParentUsePreservesWalk(t *testing.T) {
+	c, err := New(&fakeTable{}, Limits{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	left, err := c.appendSubtree(subtreeRecord{symbol: 1, endByte: 1, terminal: true}, nil, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	right, err := c.appendSubtree(subtreeRecord{symbol: 1, startByte: 1, endByte: 2, terminal: true}, nil, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	root, err := c.appendSubtree(subtreeRecord{symbol: 2, endByte: 2}, []SubtreeID{left, right}, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var scratch MaterializationPostorderScratch
+	var got []SubtreeID
+	err = c.VisitMaterializationPostorderWithParentUse([]SubtreeID{root}, nil, &scratch, 0, nil, nil, func(id SubtreeID, v *MaterializationSubtreeView) error {
+		got = append(got, id)
+		if id == root {
+			if v.ParentUse != (MaterializationParentUse{}) {
+				t.Fatal("root has a parent")
+			}
+		} else {
+			want := MaterializationParentUse{Present: true, Symbol: 2, ChildCount: 2, Last: id == right}
+			if v.ParentUse != want {
+				t.Fatalf("id=%d parent=%+v want=%+v", id, v.ParentUse, want)
+			}
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got, []SubtreeID{left, right, root}) {
+		t.Fatalf("walk=%v", got)
+	}
+	requireMaterializationPostorderScratchReset(t, &scratch)
+	// The existing callback contract receives no new parent context.
+	if err := c.VisitMaterializationPostorderPrebuiltWithBorrowedReplay([]SubtreeID{root}, nil, &scratch, 0, nil, nil, func(_ SubtreeID, v *MaterializationSubtreeView) error {
+		if v.ParentUse != (MaterializationParentUse{}) {
+			t.Fatal("old visitor received parent metadata")
+		}
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	sentinel := errors.New("publication stopped")
+	if err := c.VisitMaterializationPostorderWithParentUse([]SubtreeID{root}, nil, &scratch, 0, nil, nil, func(SubtreeID, *MaterializationSubtreeView) error { return sentinel }); !errors.Is(err, sentinel) {
+		t.Fatal(err)
+	}
+	requireMaterializationPostorderScratchReset(t, &scratch)
+	if err := c.VisitMaterializationPostorderWithParentUse([]SubtreeID{root, left}, nil, &scratch, 0, nil, nil, func(SubtreeID, *MaterializationSubtreeView) error { return nil }); err == nil {
+		t.Fatal("repeated ownership accepted")
+	}
+}
+
+func TestHiddenTailTerminalRequiresExactUse(t *testing.T) {
+	base := MaterializationSubtreeView{Terminal: true, Symbol: 1, ParentUse: MaterializationParentUse{Present: true, Last: true, ChildCount: 2, Symbol: 2}}
+	cases := []struct {
+		name   string
+		change func(*MaterializationSubtreeView)
+	}{
+		{"nonterminal", func(v *MaterializationSubtreeView) { v.Terminal = false }},
+		{"missing", func(v *MaterializationSubtreeView) { v.Missing = true }},
+		{"extra", func(v *MaterializationSubtreeView) { v.Extra = true }},
+		{"fragile", func(v *MaterializationSubtreeView) { v.Fragile = true }},
+		{"reused", func(v *MaterializationSubtreeView) { v.ReusedKey = 1 }},
+		{"error", func(v *MaterializationSubtreeView) { v.Symbol = RecoveryErrorSymbol }},
+		{"prefix", func(v *MaterializationSubtreeView) { v.LexerSkippedPrefix = true }},
+		{"root", func(v *MaterializationSubtreeView) { v.ParentUse.Present = false }},
+		{"middle", func(v *MaterializationSubtreeView) { v.ParentUse.Last = false }},
+		{"unary", func(v *MaterializationSubtreeView) { v.ParentUse.ChildCount = 1 }},
+		{"recovery_parent", func(v *MaterializationSubtreeView) { v.ParentUse.Symbol = RecoveryErrorSymbol }},
+	}
+	if !HiddenTailTerminalCanBeOmitted(&base) {
+		t.Fatal("clean hidden tail rejected")
+	}
+	for _, row := range cases {
+		t.Run(row.name, func(t *testing.T) {
+			v := base
+			row.change(&v)
+			if HiddenTailTerminalCanBeOmitted(&v) {
+				t.Fatal("unauthenticated omission admitted")
+			}
+		})
+	}
+	if HiddenTailTerminalCanBeOmitted(nil) {
+		t.Fatal("nil admitted")
+	}
+}
