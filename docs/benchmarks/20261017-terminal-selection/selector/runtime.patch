+package parsercorephase0
+
+// MaterializationParentUse describes the authenticated incoming occurrence.
+// It is supplied only by the parent-aware walk, after the ownership checks.
+// Root payloads have no parent. Sibling counts include extras.
+type MaterializationParentUse struct {
+	Symbol       Symbol
+	ProductionID uint16
+	ChildCount   uint32
+	Present      bool
+	Last         bool
+}
+
+// HiddenTailTerminalCanBeOmitted checks the compact half of an elision proof.
+// The adapter must also prove that the terminal is hidden, the parent has no
+// aliases or fields, and fresh publication needs no scanner checkpoint.
+func HiddenTailTerminalCanBeOmitted(view *MaterializationSubtreeView, use MaterializationParentUse) bool {
+	return view != nil && view.Terminal && !view.Missing && !view.Extra && !view.Fragile &&
+		view.ReusedKey == 0 && view.Symbol != RecoveryErrorSymbol && !view.LexerSkippedPrefix &&
+		use.Present && use.Last && use.ChildCount > 1 && use.Symbol != RecoveryErrorSymbol
+}
+
+// MaterializationTailSelector may omit construction of an authenticated
+// terminal at the end of a non-unary raw reduction. Returning true skips only
+// the publication visitor; record validation and occurrence ownership remain
+// mandatory. It must not retain views or mutate Core.
+type MaterializationTailSelector func(SubtreeID, *MaterializationSubtreeView, MaterializationParentUse) (bool, error)
+
+// VisitMaterializationPostorderWithTailSelection keeps the ordinary view's
+// layout and asks for representation only at eligible terminal occurrences.
+func (c *Core) VisitMaterializationPostorderWithTailSelection(roots []SubtreeID, poll func() error, scratch *MaterializationPostorderScratch, rootPre StateID, transition MaterializationReplayBorrowedTransition, prebuilt func(SubtreeID) bool, selectTail MaterializationTailSelector, visit func(SubtreeID, *MaterializationSubtreeView) error) error {
+	return c.visitMaterializationPostorderBorrowed(roots, poll, scratch, rootPre, transition, prebuilt, visit, selectTail)
+}
