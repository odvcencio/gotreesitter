+// selectHiddenTailTerminal chooses the representation before constructing a
+// leaf. Core invokes it only for an authenticated final terminal occurrence.
+func (m *compactMaterializer) selectHiddenTailTerminal(id core.SubtreeID, view *core.MaterializationSubtreeView, use core.MaterializationParentUse) (bool, error) {
+	if view.EndByte < view.StartByte || view.EndByte > uint32(len(m.source)) {
+		return false, errors.New("parser-core phase zero: compact subtree extent is outside source")
+	}
+	p := m.parser
+	if int(view.Symbol) < len(p.language.SymbolMetadata) && !p.isVisibleSymbol(Symbol(view.Symbol)) && core.HiddenTailTerminalCanBeOmitted(view, use) &&
+		!m.eager && !m.usesScannerCheckpoints && m.incrementalReuse == nil && !m.allowErrorRoot &&
+		m.rootFinalization == diagnosticParserCoreFinalizeDefault && m.purpose == core.MaterializationForPublication &&
+		!p.reduceProductionHasEffectiveFields(int(use.ChildCount), use.ProductionID, m.arena) && len(p.reduceAliasSequence(use.ProductionID)) == 0 {
+		m.nodesByID[id] = &compactElidedTailTerminal
+		return true, nil
+	}
+	return false, nil
+}
