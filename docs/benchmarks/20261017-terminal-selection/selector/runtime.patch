+func TestMaterializationTailSelectionPreservesWalk(t *testing.T) {
+	c, err := New(&fakeTable{}, Limits{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	left, err := c.appendSubtree(subtreeRecord{symbol: 1, endByte: 1, terminal: true}, nil, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	right, err := c.appendSubtree(subtreeRecord{symbol: 1, startByte: 1, endByte: 2, terminal: true}, nil, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	root, err := c.appendSubtree(subtreeRecord{symbol: 2, endByte: 2}, []SubtreeID{left, right}, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, omit := range []bool{false, true} {
+		var scratch MaterializationPostorderScratch
+		var got, selected []SubtreeID
+		err = c.VisitMaterializationPostorderWithTailSelection([]SubtreeID{root}, nil, &scratch, 0, nil, nil, func(id SubtreeID, v *MaterializationSubtreeView, use MaterializationParentUse) (bool, error) {
+			selected = append(selected, id)
+			if id != right || use != (MaterializationParentUse{Present: true, Last: true, ChildCount: 2, Symbol: 2}) {
+				t.Fatalf("unexpected selection id=%d context=%+v", id, use)
+			}
+			return omit, nil
+		}, func(id SubtreeID, v *MaterializationSubtreeView) error {
+			got = append(got, id)
+			original, err := c.MaterializationView(id)
+			if err != nil {
+				return err
+			}
+			if !reflect.DeepEqual(*v, original) {
+				t.Fatal("ordinary borrowed view changed")
+			}
+			return nil
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		want := []SubtreeID{left, right, root}
+		if omit {
+			want = []SubtreeID{left, root}
+		}
+		if !reflect.DeepEqual(got, want) || !reflect.DeepEqual(selected, []SubtreeID{right}) {
+			t.Fatalf("visits=%v selections=%v", got, selected)
+		}
+		requireMaterializationPostorderScratchReset(t, &scratch)
+	}
+	var scratch MaterializationPostorderScratch
+	sentinel := errors.New("selection stopped")
+	if err := c.VisitMaterializationPostorderWithTailSelection([]SubtreeID{root}, nil, &scratch, 0, nil, nil, func(SubtreeID, *MaterializationSubtreeView, MaterializationParentUse) (bool, error) {
+		return false, sentinel
+	}, func(SubtreeID, *MaterializationSubtreeView) error { return nil }); !errors.Is(err, sentinel) {
+		t.Fatal(err)
+	}
+	requireMaterializationPostorderScratchReset(t, &scratch)
+	if err := c.VisitMaterializationPostorderWithTailSelection([]SubtreeID{root, right}, nil, &scratch, 0, nil, nil, func(SubtreeID, *MaterializationSubtreeView, MaterializationParentUse) (bool, error) { return true, nil }, func(SubtreeID, *MaterializationSubtreeView) error { return nil }); err == nil {
+		t.Fatal("omission bypassed occurrence ownership")
+	}
+}
