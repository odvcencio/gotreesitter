+package incr
+
+// SingleFrontierEvidence closes the existing per-dispatch dependency trace.
+// The producer invalidates that trace before multiple headers, blended paths,
+// recovery, or unauthenticated scans. A final sole head alone is insufficient.
+type SingleFrontierEvidence struct {
+	SourceBytes, Frontier, Subtrees, Receipts uint64
+	Active, Disabled, Recovery                bool
+}
+
+func (e SingleFrontierEvidence) Complete() bool {
+	return e.Active && !e.Disabled && !e.Recovery && e.SourceBytes < uint64(^uint32(0)) &&
+		e.Subtrees > 0 && e.Subtrees < uint64(^uint32(0)) && e.Receipts == e.Subtrees+1 && e.Frontier > e.SourceBytes
+}
