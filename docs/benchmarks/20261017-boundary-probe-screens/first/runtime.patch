+package parsercorephase0
+
+import (
+	"math"
+	"reflect"
+	"testing"
+)
+
+func TestBoundaryProbeScratchRetainsFullIdentityAcrossReuse(t *testing.T) {
+	index, err := newBoundaryIndex(64)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// A fixed precomputed hash deliberately collides every identity. Keep the
+	// occupancy below growth so rehashing does not replace that test hash.
+	const hash = uint64(7)
+	keys := []boundaryIdentity{
+		{state: 1, byteOffset: 2, checkpoint: 3},
+		{state: 2, byteOffset: 2, checkpoint: 3},
+		{state: 1, byteOffset: 4, checkpoint: 3},
+		{state: 1, byteOffset: 2, checkpoint: 4},
+		{state: 1, byteOffset: 2, checkpoint: 3, flags: boundaryIdentityShifted},
+	}
+	scratch := boundaryProbe{slot: math.MaxUint32, found: true}
+	lookup := func(key boundaryIdentity, want NodeID) {
+		t.Helper()
+		scratch.key = key
+		scratch.hash = hash
+		before := index.logicalMap()
+		got := index.locateProbe(&scratch)
+		if got != want || scratch.found != (want != 0) || scratch.key != key || scratch.hash != hash {
+			t.Fatalf("query %+v = (%+v,%d), want id %d", key, scratch, got, want)
+		}
+		if !reflect.DeepEqual(before, index.logicalMap()) {
+			t.Fatal("lookup mutated index")
+		}
+	}
+	lookup(keys[0], 0)
+	if scratch.slot != 0 {
+		t.Fatalf("empty scratch retained slot %d", scratch.slot)
+	}
+	for n, key := range keys {
+		lookup(key, 0)
+		if err := index.publish(scratch, NodeID(n+1), nil, false); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for round := 0; round < 3; round++ {
+		for n, key := range keys {
+			lookup(key, NodeID(n+1))
+			lookup(boundaryIdentity{state: 99, byteOffset: uint32(n), checkpoint: 3}, 0)
+		}
+	}
+	lookup(keys[0], 1)
+	if err := index.publish(scratch, 19, nil, false); err != nil {
+		t.Fatal(err)
+	}
+	lookup(keys[0], 19)
+	if index.count != uint32(len(keys)) {
+		t.Fatalf("replacement count = %d", index.count)
+	}
+	index.advanceGeneration()
+	lookup(keys[0], 0)
+}
