+package parsercorephase0
+
+// boundaryProbeForKey prepares the exact identity and hash for synchronous lookup.
+func boundaryProbeForKey(key boundaryIdentity) boundaryProbe {
+	return boundaryProbe{key: key, hash: boundaryIdentityHash(key)}
+}
+
+// locateProbe resets caller-owned scratch before a full lookup. publish consumes
+// it synchronously, under the original probeWithHash lifetime contract.
+func (i *boundaryIndex) locateProbe(result *boundaryProbe) NodeID {
+	result.slot = 0
+	result.found = false
+	if id, complete := i.firstProbe(result); complete {
+		return id
+	}
+	return i.remainingProbe(result)
+}
+
+// firstProbe checks one slot. Callers supply a fresh probe or reset slot/found.
+// Keep this exact-key check small enough to inline on the condensation path.
+func (i *boundaryIndex) firstProbe(result *boundaryProbe) (NodeID, bool) {
+	if len(i.slots) == 0 {
+		return 0, true
+	}
+	result.slot = uint32(result.hash & uint64(len(i.slots)-1))
+	slot := &i.slots[result.slot]
+	if slot.generation != i.generation {
+		return 0, true
+	}
+	if slot.key == result.key {
+		result.found = true
+		return slot.id, true
+	}
+	return 0, false
+}
+
+// remainingProbe runs only after the first occupied slot has a different key.
+// It visits each remaining slot once, preserving the original full-table bound.
+func (i *boundaryIndex) remainingProbe(result *boundaryProbe) NodeID {
+	key := result.key
+	mask := uint64(len(i.slots) - 1)
+	start := uint64(result.slot)
+	for offset := uint64(1); offset < uint64(len(i.slots)); offset++ {
+		index := uint32((start + offset) & mask)
+		slot := &i.slots[index]
+		if slot.generation != i.generation {
+			result.slot = index
+			return 0
+		}
+		if slot.key == key {
+			result.slot = index
+			result.found = true
+			return slot.id
+		}
+	}
+	// The original full-table miss returns its initial zero slot.
+	result.slot = 0
+	return 0
+}
