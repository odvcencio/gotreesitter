+package gotreesitter_test
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	gts "github.com/odvcencio/gotreesitter"
+	"github.com/odvcencio/gotreesitter/grammars"
+	"github.com/odvcencio/gotreesitter/internal/benchfixtures"
+	core "github.com/odvcencio/gotreesitter/internal/parsercorephase0"
+	"os"
+	"testing"
+)
+
+func TestLinkStorageMetadataCensus(t *testing.T) {
+	type sample struct {
+		name   string
+		source []byte
+		lang   *gts.Language
+		owned  bool
+	}
+	read := func(name string) []byte {
+		data, err := os.ReadFile("internal/benchfixtures/testdata/real/" + name)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return data
+	}
+	samples := []sample{{"go/real_sample", read("go"), grammars.GoLanguage(), false}}
+	fixtures, err := benchfixtures.LoadGoFullParseFixtures()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, f := range fixtures {
+		samples = append(samples, sample{"go/" + f.Fixture.ID, f.Source, grammars.GoLanguage(), false})
+	}
+	yaml := read("yaml")
+	document := append(append([]byte("---\n"), yaml...), '\n')
+	samples = append(samples, sample{"yaml/owned_r4", yaml, grammars.YamlLanguage(), true}, sample{"yaml/owned_stream", bytes.Repeat(document, 4), grammars.YamlLanguage(), true})
+	for _, row := range samples {
+		t.Run(row.name, func(t *testing.T) {
+			if row.owned {
+				defer core.SetExternalLexerOwnershipProbeForTest(true)()
+			}
+			var snapshots []core.LinkStorageCensusForTest
+			restore := gts.SetLinkStorageCensusObserverForTest(func(c core.LinkStorageCensusForTest) { snapshots = append(snapshots, c) })
+			p := gts.NewParser(row.lang)
+			p.SetAdmissionCandidateRoute(true)
+			gts.ResetAdmissionCandidateCountersForTest()
+			tree, err := p.Parse(row.source)
+			restore()
+			if err != nil || tree == nil {
+				t.Fatalf("parse: %v", err)
+			}
+			defer tree.Release()
+			if routed, fallback := gts.AdmissionCandidateCounters(); routed != 1 || fallback != 0 || len(snapshots) != 1 {
+				t.Fatalf("route=%d/%d snapshots=%d", routed, fallback, len(snapshots))
+			}
+			digest := sha256.Sum256([]byte(tree.RootNode().SExpr(row.lang)))
+			runtime := tree.ParseRuntime()
+			second, err := p.Parse(row.source)
+			if err != nil || second == nil {
+				t.Fatalf("unobserved parse: %v", err)
+			}
+			defer second.Release()
+			if sha256.Sum256([]byte(second.RootNode().SExpr(row.lang))) != digest || runtime.TokensConsumed != second.ParseRuntime().TokensConsumed || runtime.NodesAllocated != second.ParseRuntime().NodesAllocated {
+				t.Fatal("census changed tree or native work")
+			}
+			if tree.RootNode().HasError() || tree.RootNode().EndByte() != uint32(len(row.source)) {
+				t.Fatal("not clean full span")
+			}
+			data, err := json.Marshal(struct {
+				Name         string
+				Bytes        int
+				SourceSHA256 string
+				TreeSHA256   string
+				Counts       core.LinkStorageCensusForTest
+			}{row.name, len(row.source), fmt.Sprintf("%x", sha256.Sum256(row.source)), fmt.Sprintf("%x", digest), snapshots[0]})
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Logf("LINK_STORAGE_CENSUS %s", data)
+		})
+	}
+}
