+//go:build gts_link_storage_probe
+
+package gotreesitter
+
+import core "github.com/odvcencio/gotreesitter/internal/parsercorephase0"
+
+var linkStorageCensusObserverForTest func(core.LinkStorageCensusForTest)
+
+func SetLinkStorageCensusObserverForTest(fn func(core.LinkStorageCensusForTest)) func() {
+	previous := linkStorageCensusObserverForTest
+	linkStorageCensusObserverForTest = fn
+	return func() { linkStorageCensusObserverForTest = previous }
+}
+func recordLinkStorageCensusForTest(c *core.Core, purpose core.MaterializationPurpose) {
+	if purpose != core.MaterializationForPublication || linkStorageCensusObserverForTest == nil {
+		return
+	}
+	before := c.Work()
+	counts := c.LinkStorageCensusForTest()
+	if c.Work() != before {
+		panic("read-only link census changed core work")
+	}
+	linkStorageCensusObserverForTest(counts)
+}
