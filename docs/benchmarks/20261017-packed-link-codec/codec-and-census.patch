+//go:build gts_link_storage_probe
+
+package parsercorephase0
+
+import "unsafe"
+
+type LinkStorageCensusForTest struct {
+	InlineRoundTrips, FullWidthRequests                          uint64
+	Nodes, Links, LinkCapacity, RecordBytes, MultiLinkNodes      uint64
+	ZeroMetadata, ZeroScoreOrder30, SmallScoreOrder13, ColdLinks uint64
+	OrderedLinks, UnflaggedOrders, RecoveryLinks, UnknownFlags   uint64
+	MinScore, MaxScore                                           int64
+	MaxOrder                                                     uint64
+}
+
+// Inspect only. This build-tagged probe does not select a layout or change
+// any parser state. The two packing buckets describe lossless fast cases;
+// all remaining values would require their complete-width cold representation.
+func (c *Core) LinkStorageCensusForTest() LinkStorageCensusForTest {
+	r := LinkStorageCensusForTest{Nodes: uint64(len(c.nodes)), Links: uint64(len(c.links)), LinkCapacity: uint64(cap(c.links)), RecordBytes: uint64(unsafe.Sizeof(linkRecord{}))}
+	for _, n := range c.nodes {
+		if n.linkCount > 1 {
+			r.MultiLinkNodes++
+		}
+	}
+	for _, l := range c.links {
+		if packed, ok := packInlineLinkRecord(l); ok {
+			r.InlineRoundTrips++
+			decoded, exact := packed.unpackInline()
+			if !exact || decoded != l {
+				panic("packed link census changed a logical link")
+			}
+		} else {
+			r.FullWidthRequests++
+		}
+		if l.scoreDelta == 0 && l.order == 0 && l.flags == 0 {
+			r.ZeroMetadata++
+		}
+		ordinary := l.flags & ^linkFlagHasOrder == 0
+		if ordinary && l.scoreDelta == 0 && l.order < 1<<30 {
+			r.ZeroScoreOrder30++
+		} else if ordinary && l.scoreDelta == int64(int16(l.scoreDelta)) && l.order < 1<<13 {
+			r.SmallScoreOrder13++
+		} else {
+			r.ColdLinks++
+		}
+		if l.hasOrder() {
+			r.OrderedLinks++
+		} else if l.order != 0 {
+			r.UnflaggedOrders++
+		}
+		if l.isRecoveryDiscontinuity() {
+			r.RecoveryLinks++
+		}
+		if l.flags & ^linkKnownFlags != 0 {
+			r.UnknownFlags++
+		}
+		if l.scoreDelta < r.MinScore {
+			r.MinScore = l.scoreDelta
+		}
+		if l.scoreDelta > r.MaxScore {
+			r.MaxScore = l.scoreDelta
+		}
+		if l.order > r.MaxOrder {
+			r.MaxOrder = l.order
+		}
+	}
+	if r.InlineRoundTrips != r.ZeroScoreOrder30+r.SmallScoreOrder13 || r.FullWidthRequests != r.ColdLinks {
+		panic("codec coverage differs from range census")
+	}
+	return r
+}
