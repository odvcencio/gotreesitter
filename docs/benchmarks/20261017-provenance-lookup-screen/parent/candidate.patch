+package parsercorephase0
+
+// Keep the empty-sidecar case small enough to inline in ordinary DFA callers.
+func (c *Core) externalPayloadScannerProvenance(payload SubtreeID) (externalPayloadProvenance, bool) {
+	if len(c.externalProvenance) == 0 {
+		return externalPayloadProvenance{}, false
+	}
+	return c.lookupTerminalScannerProvenance(payload)
+}
+
+func (c *Core) lookupTerminalScannerProvenance(payload SubtreeID) (externalPayloadProvenance, bool) {
+	// appendAuthenticatedTerminal is the only sparse-table producer and rejects
+	// nonterminals. A parent can still contain external descendants: this skips
+	// only its own pair lookup; recursive descendant provenance is unchanged.
+	// Ordinary terminals can carry pairs too, so external alone is not a gate.
+	if payload != 0 && uint64(payload) <= uint64(len(c.subtrees)) && !c.subtrees[payload-1].terminal {
+		return externalPayloadProvenance{}, false
+	}
+	low, high := 0, len(c.externalProvenance)
+	for low < high {
+		mid := low + (high-low)/2
+		if c.externalProvenance[mid].payload < payload {
+			low = mid + 1
+		} else {
+			high = mid
+		}
+	}
+	if low >= len(c.externalProvenance) || c.externalProvenance[low].payload != payload {
+		return externalPayloadProvenance{}, false
+	}
+	return c.externalProvenance[low], true
+}
