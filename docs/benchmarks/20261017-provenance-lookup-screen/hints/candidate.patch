+package parsercorephase0
+
+import (
+	"errors"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"unsafe"
+)
+
+func TestExternalProvenanceHintsReadCurrentRecord(t *testing.T) {
+	c := newTinyCoreWithLimits(t, Limits{})
+	c.externalProvenance = []externalPayloadProvenance{{payload: 1, start: 2, end: 3}, {payload: 65, start: 4, end: 5}}
+	for _, payload := range []SubtreeID{1, 65, 1, 65} {
+		got, ok := c.externalPayloadScannerProvenance(payload)
+		if !ok || got.payload != payload {
+			t.Fatalf("collision lookup %d: %+v %t", payload, got, ok)
+		}
+	}
+	c.externalProvenance[1].start, c.externalProvenance[1].end = 8, 9
+	got, ok := c.externalPayloadScannerProvenance(65)
+	if !ok || got.start != 8 || got.end != 9 {
+		t.Fatalf("cached stale record: %+v %t", got, ok)
+	}
+	atomic.StoreUint32(&c.externalProvenanceHints[1], ^uint32(0))
+	if got, ok := c.externalPayloadScannerProvenance(1); !ok || got.start != 2 {
+		t.Fatalf("out of range hint: %+v %t", got, ok)
+	}
+	for _, payload := range []SubtreeID{0, 2, 64, 66, ^SubtreeID(0)} {
+		if got, ok := c.externalPayloadScannerProvenance(payload); ok || got != (externalPayloadProvenance{}) {
+			t.Fatalf("absent payload %d: %+v %t", payload, got, ok)
+		}
+	}
+	// A failed lookup must not cache absence across a later publication.
+	c.externalProvenance = append(c.externalProvenance, externalPayloadProvenance{payload: 66, start: 10, end: 11})
+	if got, ok := c.externalPayloadScannerProvenance(66); !ok || got.end != 11 {
+		t.Fatalf("cached absence: %+v %t", got, ok)
+	}
+}
+
+func TestExternalProvenanceHintsSurviveRollbackAndReset(t *testing.T) {
+	c := newTinyCoreWithLimits(t, Limits{})
+	c.externalProvenance = []externalPayloadProvenance{{payload: 1, start: 2, end: 3}}
+	rollback := errors.New("rollback")
+	if err := c.ApplyAtomic(func() error {
+		c.externalProvenance = append(c.externalProvenance, externalPayloadProvenance{payload: 2, start: 4, end: 5})
+		if got, ok := c.externalPayloadScannerProvenance(2); !ok || got.end != 5 {
+			t.Fatalf("speculation: %+v %t", got, ok)
+		}
+		return rollback
+	}); !errors.Is(err, rollback) {
+		t.Fatal(err)
+	}
+	if got, ok := c.externalPayloadScannerProvenance(2); ok || got != (externalPayloadProvenance{}) {
+		t.Fatalf("rolled-back record: %+v %t", got, ok)
+	}
+	c.externalProvenance = append(c.externalProvenance, externalPayloadProvenance{payload: 2, start: 6, end: 7})
+	if got, ok := c.externalPayloadScannerProvenance(2); !ok || got.end != 7 {
+		t.Fatalf("reused record index: %+v %t", got, ok)
+	}
+	c.Reset()
+	if _, ok := c.externalPayloadScannerProvenance(2); ok {
+		t.Fatal("Reset retained a record")
+	}
+	c.externalProvenance = append(c.externalProvenance, externalPayloadProvenance{payload: 2, start: 8, end: 9})
+	if got, ok := c.externalPayloadScannerProvenance(2); !ok || got.end != 9 {
+		t.Fatalf("Reset reused identity: %+v %t", got, ok)
+	}
+}
+
+func TestExternalProvenanceHintsConcurrentReads(t *testing.T) {
+	c := newTinyCoreWithLimits(t, Limits{})
+	for i := 1; i <= 256; i++ {
+		c.externalProvenance = append(c.externalProvenance, externalPayloadProvenance{payload: SubtreeID(i), start: CheckpointID(i + 1), end: CheckpointID(i + 2)})
+	}
+	var wg sync.WaitGroup
+	for worker := 0; worker < 8; worker++ {
+		wg.Add(1)
+		go func(offset int) {
+			defer wg.Done()
+			for i := 0; i < 2048; i++ {
+				id := SubtreeID((i+offset)%256 + 1)
+				got, ok := c.externalPayloadScannerProvenance(id)
+				if !ok || got.payload != id || got.end != CheckpointID(id+2) {
+					t.Errorf("concurrent lookup %d: %+v %t", id, got, ok)
+					return
+				}
+			}
+		}(worker * 31)
+	}
+	wg.Wait()
+	if allocs := testing.AllocsPerRun(1000, func() {
+		c.externalPayloadScannerProvenance(1)
+		c.externalPayloadScannerProvenance(65)
+		c.externalPayloadScannerProvenance(257)
+	}); allocs != 0 {
+		t.Fatalf("lookup allocations=%v", allocs)
+	}
+	if size := unsafe.Sizeof(c.externalProvenanceHints); size != 256 {
+		t.Fatalf("unbounded hint storage=%d", size)
+	}
+}
