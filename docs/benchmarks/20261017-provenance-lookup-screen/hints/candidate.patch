+package parsercorephase0
+
+import "sync/atomic"
+
+const externalProvenanceHintSlots = 64
+
+// externalPayloadScannerProvenance reads the current sparse record. The hint
+// only avoids its binary search; neither a record nor an absence is cached.
+// Atomic hints preserve concurrent read access to an otherwise immutable Core.
+func (c *Core) externalPayloadScannerProvenance(payload SubtreeID) (externalPayloadProvenance, bool) {
+	if len(c.externalProvenance) == 0 {
+		return externalPayloadProvenance{}, false
+	}
+	slot := uint32(payload) & (externalProvenanceHintSlots - 1)
+	hint := atomic.LoadUint32(&c.externalProvenanceHints[slot])
+	if hint != 0 && uint64(hint) <= uint64(len(c.externalProvenance)) {
+		record := c.externalProvenance[hint-1]
+		if record.payload == payload {
+			return record, true
+		}
+	}
+	return c.searchExternalPayloadScannerProvenance(payload, slot)
+}
+
+func (c *Core) searchExternalPayloadScannerProvenance(payload SubtreeID, slot uint32) (externalPayloadProvenance, bool) {
+	low, high := 0, len(c.externalProvenance)
+	for low < high {
+		mid := low + (high-low)/2
+		if c.externalProvenance[mid].payload < payload {
+			low = mid + 1
+		} else {
+			high = mid
+		}
+	}
+	if low >= len(c.externalProvenance) || c.externalProvenance[low].payload != payload {
+		return externalPayloadProvenance{}, false
+	}
+	if uint64(low) < uint64(^uint32(0)) {
+		atomic.StoreUint32(&c.externalProvenanceHints[slot], uint32(low)+1)
+	}
+	return c.externalProvenance[low], true
+}
