+package parsercorephase0
+
+import (
+	"errors"
+	"fmt"
+	"math"
+)
+
+// computeRecoveryVisibleCount walks a cache miss. Child totals already include
+// descendant aliases, so cached children need no recursive occurrence adjustment.
+// Publish the parent only after all metadata and overflow checks succeed.
+func (c *Core) computeRecoveryVisibleCount(id SubtreeID) (recoveryVisibleCount, error) {
+	var entry recoveryVisibleCount
+	record := c.subtrees[id-1]
+	childEnd := uint64(record.firstChild) + uint64(record.childCount)
+	aliasEnd := uint64(record.firstAlias) + uint64(record.aliasCount)
+	if childEnd > uint64(len(c.children)) || aliasEnd > uint64(len(c.aliases)) {
+		return recoveryVisibleCount{}, errors.New("parser-core phase zero: recovery visible-node metadata is outside the arena")
+	}
+	if record.aliasCount != 0 && record.aliasCount != record.childCount {
+		return recoveryVisibleCount{}, fmt.Errorf("parser-core phase zero: recovery cost node %d has %d aliases for %d children",
+			id, record.aliasCount, record.childCount)
+	}
+	entry.flags = recoveryVisibleCountValid
+	if record.symbol == ErrorRegionSymbol ||
+		int(record.symbol) < len(c.recoveryVisibleSymbols) && c.recoveryVisibleSymbols[record.symbol] {
+		entry.count = 1
+		entry.flags |= recoveryVisibleCountRootVisible
+	}
+	if record.extra {
+		entry.flags |= recoveryVisibleCountExtra
+	}
+	// ERROR_REPEAT precedes ERROR in the built-in symbol range.
+	if record.symbol == ErrorRegionSymbol-1 {
+		entry.flags |= recoveryVisibleCountErrorRepeat
+	}
+	children := c.children[record.firstChild:childEnd]
+	aliases := c.aliases[record.firstAlias:aliasEnd]
+	for index, childID := range children {
+		// Published children precede their parent. This also rejects cycles.
+		if childID >= id {
+			return recoveryVisibleCount{}, errors.New("parser-core phase zero: recovery visible-node child is not a predecessor")
+		}
+		if childID == 0 {
+			continue
+		}
+		child := c.recoveryVisibleCounts[childID-1]
+		if child.flags&recoveryVisibleCountValid == 0 {
+			var err error
+			child, err = c.computeRecoveryVisibleCount(childID)
+			if err != nil {
+				return recoveryVisibleCount{}, err
+			}
+		}
+		childCount := child.count
+		// Descendants use their cached base count. Only an alias can add
+		// an invisible non-extra root; ERROR_REPEAT applies at the caller's root.
+		if len(aliases) != 0 && aliases[index] != 0 &&
+			child.flags&(recoveryVisibleCountRootVisible|recoveryVisibleCountExtra) == 0 {
+			if childCount == math.MaxUint32 {
+				return recoveryVisibleCount{}, errors.New("parser-core phase zero: recovery visible-node count overflow")
+			}
+			childCount++
+		}
+		if math.MaxUint32-entry.count < childCount {
+			return recoveryVisibleCount{}, errors.New("parser-core phase zero: recovery visible-node count overflow")
+		}
+		entry.count += childCount
+	}
+	c.recoveryVisibleCounts[id-1] = entry
+	return entry, nil
+}
