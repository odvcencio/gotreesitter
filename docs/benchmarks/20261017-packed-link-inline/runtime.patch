+func TestDiagnosticEOFRecoveryCloneDetachesFullWidthLinks(t *testing.T) {
+	live := newRecoveryVisibleCore(t)
+	original := linkRecord{prev: 1, payload: 1, scoreDelta: 1<<63 - 1, order: ^uint64(0), flags: linkFlagHasOrder}
+	id := live.appendGraphLink(original)
+	shadow := cloneDiagnosticEOFRecoveryCore(live, 0, diagnosticEOFRecoveryValidationDemand{})
+	if !diagnosticEOFRecoveryStorageDisjoint(live, shadow) || !diagnosticEOFRecoveryCopiedArenasEqual(live, shadow) {
+		t.Fatal("cold clone aliases or differs")
+	}
+	if got, err := shadow.graphLink(id); err != nil || got != original {
+		t.Fatalf("cold clone=%+v %v", got, err)
+	}
+	shadow.linkCold[0].scoreDelta--
+	if got, err := live.graphLink(id); err != nil || got != original {
+		t.Fatalf("shadow changed live=%+v %v", got, err)
+	}
+	if diagnosticEOFRecoveryCopiedArenasEqual(live, shadow) {
+		t.Fatal("cold mutation absent from equality check")
+	}
+	shadow.linkCold = live.linkCold
+	if diagnosticEOFRecoveryStorageDisjoint(live, shadow) {
+		t.Fatal("cold alias absent from disjoint check")
+	}
+}
