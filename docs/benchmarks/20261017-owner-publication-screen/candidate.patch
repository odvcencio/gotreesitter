+package parsercorephase0
+
+// headOwnerUnchanged is read only and cannot panic: both the nonzero identity
+// and its bounds are checked before indexing. Callers authenticate the active
+// scheduler token first. It reads live lineage storage rather than caching a
+// successful publication across callbacks, rollback, or Reset.
+func (c *Core) headOwnerUnchanged(head Head, lineage uint32) bool {
+	return lineage != 0 && head.Node != 0 &&
+		uint64(head.Node) <= uint64(len(c.nodeLineages)) &&
+		c.nodeLineages[head.Node-1].owner == lineage
+}
