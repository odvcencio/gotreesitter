+package parsercorephase0
+
+import (
+	"math"
+	"testing"
+	"unsafe"
+)
+
+var packedActionRowSink ActionRow
+var packedActionValueSink Action
+
+func TestPackedSingleActionPreservesAllFields(t *testing.T) {
+	cases := []Action{
+		{Type: ActionShift},
+		{Type: ActionShift, State: math.MaxUint32},
+		{Type: ActionReduce},
+		{Type: ActionReduce, Symbol: math.MaxUint16, ChildCount: math.MaxUint8,
+			DynamicPrecedence: math.MinInt16, ProductionID: math.MaxUint16},
+		{Type: ActionReduce, Symbol: 1, ChildCount: 1, DynamicPrecedence: math.MaxInt16, ProductionID: 1},
+		{Type: ActionAccept},
+		{Type: ActionRecover},
+	}
+	for _, original := range cases {
+		for flags := 0; flags < 8; flags++ {
+			action := original
+			action.Extra, action.ExtraChain, action.Repetition = flags&1 != 0, flags&2 != 0, flags&4 != 0
+			word := packSingleAction(action)
+			if word == 0 || word.action() != action {
+				t.Fatalf("round trip=%+v, want %+v; word=%x", word.action(), action, word)
+			}
+		}
+	}
+	for _, action := range []Action{
+		{Type: ActionShift, Symbol: 1}, {Type: ActionShift, ChildCount: 1},
+		{Type: ActionShift, DynamicPrecedence: -1}, {Type: ActionShift, ProductionID: 1},
+		{Type: ActionReduce, State: 1}, {Type: ActionAccept, State: 1},
+		{Type: ActionAccept, Symbol: 1}, {Type: ActionAccept, ChildCount: 1},
+		{Type: ActionAccept, DynamicPrecedence: -1}, {Type: ActionAccept, ProductionID: 1},
+		{Type: ActionRecover, Symbol: 1}, {Type: ActionType(math.MaxUint8)},
+	} {
+		if word := packSingleAction(action); word != 0 {
+			t.Fatalf("noncanonical action packed: %+v -> %x", action, word)
+		}
+		row := NewActionRow([]Action{action}, true)
+		if row.Len() != 1 || row.At(0) != action || !row.Reusable() {
+			t.Fatalf("fallback changed %+v", action)
+		}
+	}
+}
+
+func TestPackedSingleActionRowKeepsOwnershipAndBounds(t *testing.T) {
+	for _, input := range [][]Action{
+		{{Type: ActionShift, State: 2}},
+		{{Type: ActionReduce, Symbol: 8, ChildCount: 2, DynamicPrecedence: -5, ProductionID: 65535}},
+		{{Type: ActionShift, State: 2, Symbol: 9}},
+		{{Type: ActionShift, State: 2}, {Type: ActionReduce, Symbol: 8, ChildCount: 1}},
+	} {
+		want := append([]Action(nil), input...)
+		row := NewActionRow(input, true)
+		descriptor := row.Descriptor()
+		for index := range input {
+			input[index] = Action{Type: ActionRecover, State: 99}
+		}
+		if row.Len() != len(want) || row.Descriptor() != descriptor || !row.Reusable() {
+			t.Fatal("caller mutation changed immutable row metadata")
+		}
+		for index, action := range want {
+			if row.At(index) != action {
+				t.Fatalf("action %d=%+v, want %+v", index, row.At(index), action)
+			}
+			copy := row.At(index)
+			copy.State = 123
+			if row.At(index) != action {
+				t.Fatal("returned value aliases the row")
+			}
+		}
+		for _, index := range []int{-1, len(want)} {
+			func() {
+				defer func() {
+					if recover() == nil {
+						t.Fatalf("out-of-range index %d did not panic", index)
+					}
+				}()
+				_ = row.At(index)
+			}()
+		}
+	}
+}
+
+func TestPackedSingleActionRowAllocationAndHandleSize(t *testing.T) {
+	if unsafe.Sizeof(ActionRow{}) != unsafe.Sizeof(uintptr(0)) || unsafe.Sizeof(packedAction(0)) != 8 {
+		t.Fatal("public row handle widened or packed action is not eight bytes")
+	}
+	if count := testing.AllocsPerRun(100, func() {
+		packedActionRowSink = NewActionRow([]Action{{Type: ActionShift, State: 2}}, true)
+	}); count != 1 {
+		t.Fatalf("singleton row allocations=%v, want one immutable header", count)
+	}
+	c, _, boundary := newSchedulerTransactionShiftFixture(t)
+	if count := testing.AllocsPerRun(100, func() {
+		var storage Action
+		action, err := c.classifiedActionRef(boundary, 0, &storage)
+		if err != nil {
+			t.Fatal(err)
+		}
+		packedActionValueSink = *action
+	}); count != 0 {
+		t.Fatalf("classified action lookup allocations=%v, want zero", count)
+	}
+	t.Logf("Action=%d packed=%d row_handle=%d row_header=%d", unsafe.Sizeof(Action{}),
+		unsafe.Sizeof(packedAction(0)), unsafe.Sizeof(ActionRow{}), unsafe.Sizeof(actionRowData{}))
+}
