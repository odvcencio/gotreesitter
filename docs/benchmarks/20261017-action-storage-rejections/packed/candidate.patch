+package parsercorephase0
+
+// packedAction stores a canonical singleton row without a second allocation.
+// The low byte holds the kind and flags. Shifts use the next four bytes for
+// the full-width state; reductions use child/symbol/precedence/production.
+// Noncanonical unused fields retain the ordinary full Action representation.
+type packedAction uint64
+
+const packedActionPresent packedAction = 1 << 7
+
+func packSingleAction(a Action) packedAction {
+	if a.Type > ActionRecover {
+		return 0
+	}
+	p := packedActionPresent | packedAction(a.Type)
+	if a.Extra {
+		p |= 1 << 2
+	}
+	if a.ExtraChain {
+		p |= 1 << 3
+	}
+	if a.Repetition {
+		p |= 1 << 4
+	}
+	switch a.Type {
+	case ActionShift:
+		if a.Symbol != 0 || a.ChildCount != 0 || a.DynamicPrecedence != 0 || a.ProductionID != 0 {
+			return 0
+		}
+		p |= packedAction(a.State) << 8
+	case ActionReduce:
+		if a.State != 0 {
+			return 0
+		}
+		p |= packedAction(a.ChildCount)<<8 | packedAction(a.Symbol)<<16 |
+			packedAction(uint16(a.DynamicPrecedence))<<32 | packedAction(a.ProductionID)<<48
+	default:
+		if a.State != 0 || a.Symbol != 0 || a.ChildCount != 0 || a.DynamicPrecedence != 0 || a.ProductionID != 0 {
+			return 0
+		}
+	}
+	return p
+}
+
+func (p packedAction) action() Action {
+	a := Action{Type: ActionType(p & 3), Extra: p&(1<<2) != 0,
+		ExtraChain: p&(1<<3) != 0, Repetition: p&(1<<4) != 0}
+	switch a.Type {
+	case ActionShift:
+		a.State = StateID(p >> 8)
+	case ActionReduce:
+		a.ChildCount = uint8(p >> 8)
+		a.Symbol = Symbol(p >> 16)
+		a.DynamicPrecedence = int16(p >> 32)
+		a.ProductionID = uint16(p >> 48)
+	}
+	return a
+}
