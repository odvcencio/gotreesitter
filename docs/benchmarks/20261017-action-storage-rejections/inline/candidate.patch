+package parsercorephase0
+
+// actionRowData keeps a singleton's complete immutable value in the same
+// allocation as its dispatch metadata. Wider rows retain the full slice.
+type actionRowData struct {
+	descriptor ActionRowDescriptor
+	reusable   bool
+	singleton  bool
+	single     Action
+	actions    []Action
+}
+
+func newActionRowData(actions []Action, reusable bool) *actionRowData {
+	if len(actions) == 1 {
+		data := &actionRowData{reusable: reusable, singleton: true, single: actions[0]}
+		data.descriptor = describeActionRow([]Action{data.single})
+		return data
+	}
+	snapshot := append([]Action(nil), actions...)
+	return &actionRowData{actions: snapshot, descriptor: describeActionRow(snapshot), reusable: reusable}
+}
